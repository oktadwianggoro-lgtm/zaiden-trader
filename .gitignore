# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# ── Application data (personal/generated — never shared via git) ─────────
# The SQLite database holds real trading/portfolio data and is 1GB+; every
# collaborator builds their own local copy via the sync tools instead.
data/
zaiden_trader.db
*.db
*.db-shm
*.db-wal

# Trained model artifacts — large binaries, fully regenerated by
# ml_weekly's training pipeline (see README "Training the models").
models/
*.pkl
*.joblib

# Log files
*.log

# ── Scratch / ad-hoc debug scripts (not part of the app or test suite) ───
scratch/

# ── OS / editor cruft ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ── Local secrets, if any ever get added ─────────────────────────────────
.env
.env.*
*.local.json
